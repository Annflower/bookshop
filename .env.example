# Скопируйте этот файл в .env и укажите свои значения.
# DATABASE_URL — строка подключения MySQL.
#   Формат: mysql+pymysql://<user>:<pass>@<host>:<port>/<dbname>?charset=utf8mb4

DATABASE_URL=mysql+pymysql://root:@localhost:3306/bookshop_full?charset=utf8mb4

# Секрет для подписи токенов авторизации (обязателен).
# Сгенерируйте длинный случайный:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-please-put-a-real-long-secret-here

# Пароль root для локальной MySQL в docker-compose (только для dev).
# В репозитории не хранится — в docker-compose берётся из .env, дефолт root.
MYSQL_ROOT_PASSWORD=root

# ВНИМАНИЕ: API_TOKEN больше не используется.
# Аналитика теперь защищена входом пользователя с ролью admin (Bearer-токен),
# а не отдельным API-токеном. Если API_TOKEN остался в вашем .env — удалите его.
